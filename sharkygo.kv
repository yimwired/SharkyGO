#sharkygo.kv
<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 15

        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'assets/images/new_background.png'
            
        FloatLayout:
            size_hint: 1, 1

            Label:
                id: title
                text: 'SharkyGo'
                font_size: 70
                bold: True
                font_name: 'assets/fonts/Pixellettersfull-BnJ5.ttf'
                color: 1, 1, 1, 1
                size_hint_y: None
                height: 120
                pos_hint: {"center_x": 0.5, "top": 1}
                canvas.before:
                    PushMatrix
                    Scale:
                        origin: self.center
                        x: root.scale
                        y: root.scale
                canvas.after:
                    PopMatrix

                on_parent: root.animate_title(self)

        ToggleButton:
            id: music_toggle
            size_hint: None, None
            size: 70, 53
            pos_hint: {"right": 1, "top": 1}
            background_normal: 'assets/images/play.png' if self.state == 'normal' else 'assets/images/mute.png'
            background_down: 'assets/images/mute.png' if self.state == 'normal' else 'assets/images/play.png'
            on_state: root.toggle_music(self)

        Button:
            text: 'START GAME'
            font_size: 36
            bold: True
            font_name: 'assets/fonts/Pixellettersfull-BnJ5.ttf'
            background_normal: ''
            background_color: 0.0, 0.6, 0.0, 1
            color: 1, 1, 1, 1
            size_hint: None, None
            size: 280, 100
            pos_hint: {"center_x": 0.5}
    
            canvas.before:
                Color:
                    rgba: 0.2, 0.8, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [30,]

            on_press:
                self.background_color = (0.1, 0.5, 0.1, 1)
                self.size = (270, 95)
            on_release:
                self.background_color = (0.0, 0.6, 0.0, 1)
                self.size = (280, 100)
                root.manager.current = 'game'

        Label:
            text: 'Volume'
            font_size: 24
            font_name: 'assets/fonts/Pixellettersfull-BnJ5.ttf'
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 40

        Slider:
            id: volume_slider
            min: 0
            max: 1
            value: root.volume
            size_hint: None, None
            size: 280, 100
            pos_hint: {"center_x": 0.5}
            on_value: root.adjust_volume(self.value)

        Button:
            text: 'QUIT'
            font_size: 32
            bold: True
            font_name: 'assets/fonts/Pixellettersfull-BnJ5.ttf'
            background_normal: ''
            background_color: 0.7, 0.2, 0.2, 1
            color: 1, 1, 1, 1
            size_hint: None, None
            size: 280, 100
            pos_hint: {"center_x": 0.5}
    
            canvas.before:
                Color:
                    rgba: 0.2, 0.8, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [30,]
            
            on_press:
                self.background_color = (0.1, 0.5, 0.1, 1)
                self.size = (270, 95)
            on_release:
                self.background_color = (0.2, 0.8, 0.2, 1)
                self.size = (280, 100)

            on_press: app.stop()

        Label:
            text: 'Created by 6710110132, 6710110109'
            font_size: 22
            font_name: 'assets/fonts/Pixellettersfull-BnJ5.ttf'
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 50

<GameScreen>:
    SharkyGoGame:
        id: game

<SharkyGoGame>:
    shark: shark
    top_pipe: top_pipe
    bottom_pipe: bottom_pipe
    score: root.score
    canvas:
        Rectangle:
            pos: self.pos
            size: self.size
            source: root.background.source

    Shark:
        id: shark
        pos: root.width / 4, root.height / 2

    Pipe:
        id: top_pipe
        size: 100, 350
        size_hint: None, None
        pos: root.width, root.height - 300
        origin: self.center
        angle: 180

    Pipe:
        id: bottom_pipe
        size: 100, 350
        size_hint: None, None
        pos: root.width, 0

    FloatLayout:
        size: root.size
        Label:
            text: str(root.score)
            font_size: 50
            bold: True
            color: 1, 1, 1, 1
            pos_hint: {"center_x": 0.5, "top": 1.4}

        Image:
            id: gameover
            source: 'assets/images/gameover.png'
            opacity: 0
            disabled: True
            size_hint: None, None
            size: 300, 100
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

<Shark>:
    size_hint: None, None
    size: 70, 50

<Pipe>:
    allow_stretch: True
    keep_ratio: False